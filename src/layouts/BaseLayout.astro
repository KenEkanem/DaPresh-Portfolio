---
import { getEntry } from 'astro:content';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const settings = await getEntry('settings', 'settings');
if (!settings) throw new Error('Missing src/content/site/settings.json');

const title = Astro.props.title ?? settings.data.siteTitle;
const description = Astro.props.description ?? settings.data.description;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
