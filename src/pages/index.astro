---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Resume from '../components/Resume.astro';
import Brand from '../components/Brand.astro';
---

<BaseLayout>
  <Header />
  <main>
    <Hero />
    <About next={{ href: '#resume', label: 'Scroll to Resumé' }} />
    <Resume next={{ href: '#brand', label: 'Scroll to Brand' }} />
    <!-- Add next={{ href: '#portfolio', label: 'Scroll to Portfolio' }} once Portfolio exists -->
    <Brand />
    <!-- Coming next: Portfolio, Contact -->
  </main>
</BaseLayout>
