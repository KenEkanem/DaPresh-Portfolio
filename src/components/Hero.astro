---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import LogoMark from './LogoMark.astro';
import SocialIcons from './SocialIcons.astro';

const hero = await getEntry('hero', 'hero');
const settings = await getEntry('settings', 'settings');
if (!hero || !settings) throw new Error('Missing hero.json or settings.json');

const { firstName, lastName, role, backgroundImage, backgroundAlt, focusX, showLogoMark, logoMark } = hero.data;
const { siteName, copyrightYear } = settings.data;

// Aspect ratio of the photo "stage" that the logo is positioned on.
const ratio = backgroundImage ? backgroundImage.width / backgroundImage.height : 16 / 9;
const vars = `--stage-ratio: ${ratio}; --focus-m: ${focusX / 100}`;
---

<section id="home" class="hero" data-nav="home" style={vars}>
  <!--
    .hero-media is the visible window onto the photo (the whole hero on desktop, the top
    two-thirds on portrait screens). .hero-stage inside it behaves like object-fit: cover
    with a focal point, and the logo is positioned in % of the stage, so it stays locked
    to the same spot on the photo at every screen size.
  -->
  <div class="hero-media">
    <div class="hero-stage">
      {
        backgroundImage && (
          <Image
            src={backgroundImage}
            alt={backgroundAlt}
            widths={[640, 960, 1440, backgroundImage.width]}
            sizes="(max-aspect-ratio: 4/5) 100vh, 100vw"
            loading="eager"
            fetchpriority="high"
          />
        )
      }
      {
        showLogoMark && (
          <div class="mark" style={`left: ${logoMark.left}%; top: ${logoMark.top}%; width: ${logoMark.width}%`}>
            <LogoMark />
          </div>
        )
      }
    </div>
  </div>
  <div class="hero-shade" aria-hidden="true"></div>

  <div class="container hero-content">
    <h1 class="hero-name">
      <span class="first">{firstName}</span>
      <span class="last">{lastName}</span>
    </h1>
    <p class="hero-role">{role}</p>
    <span class="accent-bar hero-bar"></span>
  </div>

  <div class="container hero-footer">
    <SocialIcons />
    <p class="copyright">{siteName} | © {copyrightYear} | All Rights Reserved</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    padding-top: var(--header-h);
    overflow: hidden;
    isolation: isolate;
    background: #030303;
    --focus: 0.5; /* horizontal focal point of the photo (0–1) */
  }

  /* ---------- photo ---------- */
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    container-type: size;
  }
  .hero-stage {
    /* cover the window, but don't upscale past ~2400px on huge screens */
    --w: min(max(100cqw, calc(100cqh * var(--stage-ratio))), 2400px);
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    width: var(--w);
    aspect-ratio: var(--stage-ratio);
    /* keep the focal point centred, but never let the photo's edge show */
    left: clamp(calc(100cqw - var(--w)), calc(50cqw - var(--focus) * var(--w)), 0px);
    /* feather all four edges into the page background */
    --fade-x: clamp(40px, 8%, 200px);
    --fade-y: clamp(40px, 10%, 180px);
    -webkit-mask-image:
      linear-gradient(to right, transparent, #000 var(--fade-x), #000 calc(100% - var(--fade-x)), transparent),
      linear-gradient(to bottom, transparent, #000 var(--fade-y), #000 calc(100% - var(--fade-y)), transparent);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent, #000 var(--fade-x), #000 calc(100% - var(--fade-x)), transparent),
      linear-gradient(to bottom, transparent, #000 var(--fade-y), #000 calc(100% - var(--fade-y)), transparent);
    mask-composite: intersect;
  }
  .hero-stage :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mark {
    position: absolute;
    color: #fff;
    filter: drop-shadow(0 0 6px rgba(255, 255, 255, 0.35));
    pointer-events: none;
  }
  .mark :global(svg) { width: 100%; height: auto; }

  /* keeps the name readable on the left */
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to right, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.2) 45%, transparent 65%);
  }

  /* ---------- text ---------- */
  .hero-content {
    align-self: center;
    padding-bottom: 4vh;
  }
  .hero-name {
    margin: 0;
    line-height: 0.95;
    text-transform: uppercase;
  }
  .first {
    display: block;
    font-weight: 400;
    font-size: clamp(2.75rem, 5.2vw, 5.5rem);
  }
  .last {
    display: block;
    font-weight: 900;
    font-size: clamp(3.25rem, 7.6vw, 8rem);
    letter-spacing: -0.01em;
  }
  .hero-role {
    margin: 0.6rem 0 0.9rem;
    font-size: clamp(1.1rem, 2.15vw, 2.25rem);
    letter-spacing: 0.42em;
  }
  .hero-bar { width: clamp(100px, 10vw, 145px); }

  .hero-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 2rem;
  }
  .copyright { margin: 0; font-size: 1.05rem; }

  /* ═════════ Portrait screens (phones, portrait tablets) ═════════
     Photo fills the top ~2/3, centred on the monitor + right lamp + logo,
     fading into black; the name sits below it, fully readable. */
  @media (max-aspect-ratio: 4/5) {
    .hero { --focus: var(--focus-m); }
    .hero { --media-h: 64svh; }
    .hero-media {
      inset: 0 0 auto 0;
      height: var(--media-h);
      -webkit-mask-image: linear-gradient(to bottom, #000 50%, transparent 100%);
      mask-image: linear-gradient(to bottom, #000 50%, transparent 100%);
    }
    .hero-shade { display: none; }
    /* name starts over the photo's faded bottom edge, so there's no empty gap */
    .hero-content {
      align-self: start;
      padding-top: max(1rem, calc(var(--media-h) - var(--header-h) - 5.5rem));
      padding-bottom: 0.5rem;
      text-shadow: 0 2px 18px rgba(0, 0, 0, 0.85);
    }
    .first { font-size: clamp(2.1rem, 10.5vw, 4.5rem); }
    .last { font-size: clamp(2.9rem, 14.5vw, 6.5rem); }
    .hero-role { font-size: clamp(1rem, 4.4vw, 1.75rem); letter-spacing: 0.36em; }
    .hero-footer { padding-block: 1.5rem 2rem; }
  }

  /* ═════════ Narrow phones ═════════ */
  @media (max-width: 640px) {
    .hero-footer { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
    .copyright { font-size: 0.9rem; color: var(--text-muted); }
  }

  /* ═════════ Short landscape screens (phones turned sideways) ═════════ */
  @media (orientation: landscape) and (max-height: 520px) {
    .hero-content { padding-bottom: 0; }
    .first { font-size: clamp(1.75rem, 11vh, 3rem); }
    .last { font-size: clamp(2.25rem, 16vh, 4.5rem); }
    .hero-role { font-size: clamp(0.85rem, 4.5vh, 1.25rem); margin: 0.4rem 0 0.6rem; }
    .hero-footer { padding-block: 0.75rem; }
    .copyright { font-size: 0.85rem; }
  }
</style>
