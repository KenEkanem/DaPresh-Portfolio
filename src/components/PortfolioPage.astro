---
/**
 * One full-screen portfolio page, driven by a JSON file in src/content/portfolio/.
 *
 * Layouts (all measured from the PDF):
 *  - showcase       heading + 2 tiles left, big tile right, a row of tiles below   (p7)
 *  - duo            two projects side by side, each a 2-column mosaic              (p8)
 *  - grid           equal columns                                                   (p9, 13, 14, 16)
 *  - feature-left   heading + big tile left, grid of smaller tiles right            (p10, 12)
 *  - feature-center 2 tiles | big tile | 2 tiles                                    (p11)
 *  - justified      rows of mixed-width tiles that share one height per row        (p15, 17)
 *
 * Phones (≤700px) get a compact Mosaic per project instead of these layouts, and the
 * page is only as tall as its content. Every tile opens the full-screen viewer (Lightbox).
 *
 * Trick used throughout: inside a `.row`, each tile gets `flex-grow: <its ratio>`, so
 * widths are proportional to aspect ratios and every tile in the row ends up the same height.
 */
import type { CollectionEntry } from 'astro:content';
import Tile from './Tile.astro';
import PortfolioHeading from './PortfolioHeading.astro';
import ScrollCue from './ScrollCue.astro';
import Mosaic from './Mosaic.astro';
import GalleryData from './GalleryData.astro';
import { toSlides } from '../lib/gallery';

interface Props {
  page: CollectionEntry<'portfolioPages'>;
  next?: { href: string; label: string };
}
const { page, next } = Astro.props;
const d = page.data;
const [first] = d.projects;
const items = first.items;
const titleId = `${d.anchor}-title`;

const fr = (n?: number[], fallback = '1fr 1fr') => (n?.length ? n.map((x) => `${x}fr`).join(' ') : fallback);

// justified: split items into rows by the counts in `rows`
const rows: (typeof items)[] = [];
if (d.layout === 'justified') {
  let i = 0;
  for (const count of d.rows ?? [items.length]) {
    rows.push(items.slice(i, i + count));
    i += count;
  }
  if (i < items.length) rows.push(items.slice(i));
}

// Viewer slides, in the same order as the tiles' `open` indices.
// Desktop: duo has one gallery per project; the other layouts show only the first project.
const desktopSlides = await Promise.all(
  (d.layout === 'duo' ? d.projects : [first]).map((p) => toSlides(p.items, p)),
);

// Phones: one mosaic per project, featured image first.
const featuredFirst = (list: typeof items) =>
  d.layout === 'showcase' && list[2] ? [list[2], ...list.slice(0, 2), ...list.slice(3)] : list;
const mobileProjects = await Promise.all(
  d.projects.map(async (p) => {
    const ordered = featuredFirst(p.items);
    return { ...p, ordered, slides: await toSlides(ordered, p) };
  }),
);

const style = `--cols: ${d.columns}`;
---

<section
  id={d.anchor}
  class:list={['page', 'pf-page', `layout-${d.layout}`]}
  data-nav="portfolio"
  aria-labelledby={titleId}
  style={style}
>
  <div class="container pf-desktop" data-gallery-scope={d.layout === 'duo' ? undefined : ''}>
    {d.layout !== 'duo' && <GalleryData slides={desktopSlides[0]} />}
    {/* ───── heading shown above the content (most layouts) ───── */}
    {
      ['grid', 'feature-center', 'justified'].includes(d.layout) && (
        <PortfolioHeading id={titleId} heading={first.heading} title={first.title} client={first.client} date={first.date} />
      )
    }

    {
      d.layout === 'showcase' && (
        <div class="showcase">
          <div class="sc-top" style={`grid-template-columns: ${fr(d.proportions, '448fr 622fr')}`}>
            <div class="sc-left">
              <PortfolioHeading id={titleId} heading={first.heading} title={first.title} client={first.client} date={first.date} />
              <div class="row sc-pair">
                {items.slice(0, 2).map((it, i) => <Tile item={it} open={i} sizes="20vw" />)}
              </div>
            </div>
            {items[2] && <Tile class="sc-main" item={items[2]} open={2} sizes="55vw" />}
          </div>
          <div class="row sc-bottom">
            {items.slice(3).map((it, i) => <Tile item={it} open={3 + i} sizes="33vw" />)}
          </div>
        </div>
      )
    }

    {
      d.layout === 'duo' && (
        <div class="duo">
          {d.projects.map((p, pi) => {
            const split = p.split ?? Math.ceil(p.items.length / 2);
            return (
              <article class="duo-project" data-gallery-scope>
                <GalleryData slides={desktopSlides[pi]} />
                <PortfolioHeading
                  id={pi === 0 ? titleId : `${d.anchor}-title-${pi}`}
                  heading={p.heading}
                  title={p.title}
                  client={p.client}
                  date={p.date}
                />
                <div class="duo-tiles">
                  <div class="stack">
                    {p.items.slice(0, split).map((it, i) => <Tile item={it} open={i} sizes="(max-width: 900px) 50vw, 20vw" />)}
                  </div>
                  <div class="stack">
                    {p.items.slice(split).map((it, i) => <Tile item={it} open={split + i} sizes="(max-width: 900px) 50vw, 20vw" />)}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      )
    }

    {
      d.layout === 'grid' && (
        <div class="grid">
          {items.map((it, i) => <Tile item={it} open={i} sizes={`(max-width: 1000px) 33vw, ${Math.round(100 / d.columns)}vw`} />)}
        </div>
      )
    }

    {
      d.layout === 'feature-left' && (
        <div class="fl" style={`grid-template-columns: ${fr(d.proportions, '1fr 2fr')}`}>
          <div class="fl-left">
            <PortfolioHeading id={titleId} heading={first.heading} title={first.title} client={first.client} date={first.date} />
            <Tile item={items[0]} open={0} sizes="35vw" />
          </div>
          <div class="grid fl-smalls">
            {items.slice(1).map((it, i) => <Tile item={it} open={1 + i} sizes="20vw" />)}
          </div>
        </div>
      )
    }

    {
      d.layout === 'feature-center' && (
        <div class="fc" style={`grid-template-columns: ${fr(d.proportions, '1fr 2fr 1fr')}`}>
          <div class="stack fc-side">
            {items.slice(1, 3).map((it, i) => <Tile item={it} open={1 + i} sizes="20vw" />)}
          </div>
          <Tile class="fc-main" item={items[0]} open={0} sizes="45vw" />
          <div class="stack fc-side">
            {items.slice(3, 5).map((it, i) => <Tile item={it} open={3 + i} sizes="20vw" />)}
          </div>
        </div>
      )
    }

    {
      d.layout === 'justified' && (
        <div class="justified">
          {rows.map((row) => (
            <div class="row">
              {row.map((it) => <Tile item={it} open={items.indexOf(it)} sizes="30vw" />)}
            </div>
          ))}
        </div>
      )
    }

  </div>

  {/* ───── phones: one mosaic per project (hidden on larger screens; its lazy images don't load there) ───── */}
  <div class="container pf-mobile">
    {
      mobileProjects.map((p, pi) => (
        <div class="m-project" data-gallery-scope>
          <GalleryData slides={p.slides} />
          <PortfolioHeading
            id={`${d.anchor}-m-title-${pi}`}
            heading={p.heading}
            title={p.title}
            client={p.client}
            date={p.date}
          />
          <Mosaic items={p.ordered} />
        </div>
      ))
    }
  </div>

  {next && <ScrollCue href={next.href} label={next.label} />}
</section>

<style>
  .pf-page {
    --gap: clamp(0.75rem, 1.6vw, 1.5rem);
    background: radial-gradient(ellipse 80% 70% at 50% 50%, #121212, #070707 75%);
  }

  /* ---------- shared building blocks ---------- */
  .row { display: flex; gap: var(--gap); }
  .row > :global(.tile) { flex: var(--r) 1 0%; }

  .stack { display: flex; flex-direction: column; gap: var(--gap); }

  .grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--gap);
  }

  /* ---------- showcase ---------- */
  .showcase { display: grid; gap: var(--gap); }
  .sc-top { display: grid; gap: var(--gap); }
  .sc-left {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
  }

  /* ---------- duo ---------- */
  .duo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
  }
  .duo-tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap);
    border-radius: 22px;
    overflow: hidden;
  }
  /* both columns stretch to the taller one; spare space goes into the gaps so the bottoms line up */
  .duo-tiles .stack { gap: calc(var(--gap) * 0.66); justify-content: space-between; }

  /* ---------- feature-left ---------- */
  .fl { display: grid; gap: var(--gap); align-items: end; }
  .fl-left {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-self: stretch;
    min-width: 0;
  }

  /* ---------- feature-center ---------- */
  .fc { display: grid; gap: var(--gap); align-items: center; }

  /* ---------- justified ---------- */
  .justified { display: grid; gap: var(--gap); }

  .pf-mobile { display: none; }

  /* ═════════════ Tablet ═════════════ */
  @media (max-width: 1000px) {
    .grid { grid-template-columns: repeat(min(var(--cols), 3), minmax(0, 1fr)); }
    .fl-smalls { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); }
    .duo { grid-template-columns: 1fr; max-width: 640px; }
  }

  /* ═════════════ Phone: mosaics instead of the layouts ═════════════
     Pages are only as tall as their content (no full-screen pages, no scroll cue),
     so the portfolio reads as one continuous feed. */
  @media (max-width: 700px) {
    .pf-page {
      min-height: 0;
      padding-block: 1.75rem;
      /* clear the fixed header + sticky category tabs when jumping to a page */
      scroll-margin-top: calc(var(--header-h) + 2.5rem);
    }
    .pf-page > :global(.scroll-cue) { display: none; }
    .pf-desktop { display: none; }
    .pf-mobile { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2.75rem; }
    .m-project :global(.pf-heading) { margin-bottom: 0.9rem; }
  }
</style>
