---
/**
 * One portfolio image slot. Its shape comes from `ratio` ("w/h"), so swapping the
 * placeholder for a real image never changes the layout.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  item: {
    image?: ImageMetadata;
    alt: string;
    ratio: string;
    label?: string;
    title?: string;
    client?: string;
    date?: string;
  };
  sizes?: string;
  class?: string;
  /** index of this tile in its gallery: makes the tile a button that opens the full-screen viewer */
  open?: number;
  /** shows a "+N" overlay (the gallery has N more images than are shown) */
  more?: number;
}
const { item, sizes = '(max-width: 640px) 100vw, 33vw', class: className, open, more = 0 } = Astro.props;

const [w, h] = item.ratio.split('/').map(Number);
const r = w / h;

// Friendly ratio label for placeholders: snap to a common ratio when close.
const common: [number, number][] = [[1, 1], [4, 5], [5, 4], [3, 4], [4, 3], [2, 3], [3, 2], [7, 8], [16, 9], [2, 1], [3, 1]];
const match = common.find(([a, b]) => Math.abs(a / b - r) / r < 0.03);
const ratioLabel = match ? `${match[0]}:${match[1]}` : `${w}:${h}`;

const meta = [item.client, item.date].filter(Boolean).join(' · ');
const hasCaption = Boolean(item.title || meta);

const name = item.title ?? item.label ?? item.alt;
const Media = open === undefined ? 'div' : 'button';
const mediaAttrs =
  open === undefined
    ? {}
    : {
        type: 'button' as const,
        'data-open': open,
        'aria-label': more > 0 ? `View all images (${more} more)` : `View full size${name ? `: ${name}` : ''}`,
      };
---

<figure class:list={['tile', className]} style={`--r: ${r}`}>
  <Media class:list={['media', { zoomable: open !== undefined }]} {...mediaAttrs}>
  {
    item.image ? (
      <Image src={item.image} alt={item.alt} sizes={sizes} widths={[400, 800, 1200, 1600]} />
    ) : (
      <span class="ph" role="img" aria-label={`Placeholder${item.label ? `: ${item.label}` : ''}, ${ratioLabel}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3" y="4" width="18" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="1.5" />
          <circle cx="9" cy="10" r="1.8" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path d="M3.5 18l5.5-5.5 4 4 2.5-2.5 5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
        </svg>
        <span class="ph-ratio">{ratioLabel}</span>
        {item.label && <span class="ph-label">{item.label}</span>}
      </span>
    )
  }
  {more > 0 && <span class="more" aria-hidden="true">+{more}</span>}
  </Media>
  {
    hasCaption && (
      <figcaption>
        {item.title && <span class="cap-title">{item.title}</span>}
        {meta && <span class="cap-meta">{meta}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .tile {
    margin: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  /* the image box: its shape always matches the PDF */
  .media {
    position: relative;
    aspect-ratio: var(--r);
    overflow: hidden;
    border-radius: var(--tile-radius, 0);
    background: #141414;
  }
  .media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* tiles that open the full-screen viewer */
  button.media {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    font: inherit;
    color: inherit;
    cursor: zoom-in;
  }
  .zoomable :global(img), .zoomable .ph { transition: transform 0.4s ease, filter 0.3s ease; }
  @media (hover: hover) {
    .zoomable:hover :global(img), .zoomable:hover .ph { transform: scale(1.03); }
  }
  .zoomable:focus-visible { outline-offset: 2px; }

  .more {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgba(0, 0, 0, 0.58);
    font-weight: 800;
    font-size: clamp(1.4rem, 7vw, 2.2rem);
    letter-spacing: 0.02em;
  }

  .ph {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    padding: 0.5rem;
    text-align: center;
    color: #6f6f6f;
    background:
      repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.025) 0 10px, transparent 10px 20px),
      linear-gradient(160deg, #1d1d1d, #111);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    border-radius: inherit;
    container-type: size;
  }
  .ph svg { width: clamp(18px, 14cqmin, 40px); height: auto; }
  .ph-ratio {
    font-size: clamp(0.65rem, 7cqmin, 0.95rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #8a8a8a;
  }
  .ph-label {
    font-size: clamp(0.6rem, 6cqmin, 0.8rem);
    line-height: 1.2;
  }
  /* caption: one line each, so captions in a row stay the same height */
  figcaption {
    display: grid;
    padding-top: 0.5rem;
    line-height: 1.3;
  }
  .cap-title, .cap-meta {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .cap-title { font-weight: 600; font-size: clamp(0.85rem, 1vw, 0.95rem); }
  .cap-meta { font-weight: 300; font-size: clamp(0.75rem, 0.9vw, 0.85rem); color: var(--text-muted); }

  /* very short strips: hide the icon and label so the ratio still fits */
  @container (max-height: 60px) {
    .ph svg, .ph-label { display: none; }
  }
</style>
