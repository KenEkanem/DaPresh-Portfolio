---
/**
 * Portfolio page heading: SECTION HEADING, then the project's title, client and date,
 * with the yellow bar after the last line (as in the PDF).
 */
interface Props {
  id?: string;
  heading: string;
  title?: string;
  client?: string;
  date?: string;
}
const { id, heading, title, client, date } = Astro.props;
const lines = [
  title && { label: 'Project', text: title, cls: 'meta-title' },
  client && { label: 'Client', text: client, cls: 'meta' },
  date && { label: 'Date', text: date, cls: 'meta' },
].filter(Boolean) as { label: string; text: string; cls: string }[];
---

<header class="pf-heading">
  <h2 id={id}>{heading}</h2>
  {
    lines.length > 0 && (
      <dl class="details">
        {lines.map((line, i) => (
          <div class={line.cls}>
            <dt class="visually-hidden">{line.label}</dt>
            <dd>
              {line.text}
              {i === lines.length - 1 && <span class="accent-bar bar-inline" aria-hidden="true" />}
            </dd>
          </div>
        ))}
      </dl>
    )
  }
  {lines.length === 0 && <span class="accent-bar bar-below" />}
</header>

<style>
  .pf-heading { margin-bottom: clamp(1rem, 2.5vh, 2rem); }
  h2 {
    margin: 0 0 0.15rem;
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(1.35rem, 2.05vw, 2rem);
    line-height: 1.05;
    letter-spacing: 0.01em;
  }
  .details { margin: 0; }
  dd {
    margin: 0;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 4vw, 3.5rem);
    line-height: 1.2;
  }
  .meta-title dd {
    font-weight: 500;
    font-size: clamp(1.1rem, 1.65vw, 1.55rem);
  }
  .meta dd {
    font-weight: 300;
    font-size: clamp(1rem, 1.45vw, 1.35rem);
    color: #d6d6d6;
  }
  .bar-inline { width: clamp(70px, 7.5vw, 110px); flex: none; }
  .bar-below { margin-top: 0.5rem; width: clamp(70px, 7.5vw, 110px); }
</style>
