---
import { getEntry } from 'astro:content';
import LogoMark from './LogoMark.astro';
import ScrollCue from './ScrollCue.astro';
import Tile from './Tile.astro';

interface Props {
  next?: { href: string; label: string };
}
const { next } = Astro.props;

const portfolio = await getEntry('portfolio', 'portfolio');
if (!portfolio) throw new Error('Missing src/content/site/portfolio.json');
const { title, categories } = portfolio.data;
---

<section id="portfolio" class="page portfolio" data-nav="portfolio" aria-labelledby="portfolio-title">
  <div class="container">
    <header class="page-heading heading-row">
      <div>
        <h2 id="portfolio-title" class="section-title">{title}</h2>
        <span class="accent-bar"></span>
      </div>
      <LogoMark class="pf-mark" filled />
    </header>

    <ul class="cards" aria-label="Portfolio categories">
      {
        categories.map((c) => (
          <li>
            <a class="card" href={`#${c.target}`}>
              <h3>{c.title}</h3>
              <Tile item={c.cover} sizes="(max-width: 1000px) 45vw, 25vw" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  {next && <ScrollCue href={next.href} label={next.label} />}
</section>

<style>
  .portfolio {
    background:
      radial-gradient(ellipse 60% 55% at 50% 60%, rgba(120, 130, 150, 0.12), transparent 70%),
      linear-gradient(180deg, #0b0b0d, #050505);
  }
  .heading-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .heading-row :global(.pf-mark) {
    width: clamp(36px, 4vw, 56px);
    color: var(--text);
    margin-right: clamp(0px, 6vw, 7rem);
  }

  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.75rem);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    height: 100%;
    padding: clamp(1.25rem, 2vw, 1.75rem) clamp(0.9rem, 1.4vw, 1.25rem);
    border-radius: 22px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background:
      radial-gradient(ellipse 80% 60% at 50% 45%, rgba(170, 180, 205, 0.28), transparent 75%),
      linear-gradient(180deg, rgba(60, 64, 74, 0.55), rgba(20, 21, 25, 0.8));
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.45);
    transition: transform 0.25s ease, border-color 0.25s ease;
    --tile-radius: 16px;
  }
  .card:hover,
  .card:focus-visible {
    transform: translateY(-6px);
    border-color: var(--accent);
  }
  .card h3 {
    margin: 0;
    min-height: 2.4em;
    text-align: center;
    font-weight: 800;
    font-size: clamp(1.05rem, 1.65vw, 1.55rem);
    line-height: 1.2;
    display: grid;
    place-items: center;
  }
  .card :global(.tile) { margin-top: auto; }

  /* Tablets: 2 x 2 */
  @media (max-width: 1000px) {
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* Phones: compact 2 x 2 index (no sideways scrolling; the sticky tabs take over below) */
  @media (max-width: 700px) {
    .cards { gap: 0.75rem; }
    .card {
      gap: 0.75rem;
      padding: 0.85rem 0.7rem 0.75rem;
      border-radius: 16px;
      --tile-radius: 10px;
    }
    .card h3 { font-size: 0.95rem; min-height: 2.5em; }
  }
</style>
