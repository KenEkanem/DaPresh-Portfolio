---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import ScrollCue from './ScrollCue.astro';

interface Props {
  next?: { href: string; label: string };
}
const { next } = Astro.props;

const about = await getEntry('about', 'about');
if (!about) throw new Error('Missing src/content/site/about.json');
const { title, linkLabel, linkUrl, paragraphs, portrait, portraitAlt } = about.data;
---

<section id="about" class="page about" data-nav="about" aria-labelledby="about-title">
  <div class="container about-grid">
    <div class="about-text">
      <header class="page-heading">
        <h2 id="about-title" class="section-title">{title}</h2>
        <span class="accent-bar"></span>
        {
          linkUrl && (
            <a class="about-link" href={linkUrl} target="_blank" rel="noopener noreferrer">
              {linkLabel || linkUrl}
            </a>
          )
        }
      </header>
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>

    {
      portrait && (
        <div class="portrait">
          <Image src={portrait} alt={portraitAlt} widths={[360, 560, 800, 1000]} sizes="(max-width: 900px) 70vw, 560px" />
        </div>
      )
    }
  </div>

  {next && <ScrollCue href={next.href} label={next.label} />}
</section>

<style>
  .about {
    background: radial-gradient(ellipse 70% 80% at 70% 50%, #181818, #0a0a0a 70%);
  }
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
  }
  .about-link {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    transition: color 0.2s;
  }
  .about-link:hover { color: var(--accent); }

  .about-text p {
    margin: 0 0 1.5rem;
    font-size: clamp(1rem, 1.35vw, 1.2rem);
    font-weight: 300;
    line-height: 1.6;
    max-width: 34rem;
  }

  /* Circular portrait with a brushed-silver ring */
  .portrait {
    justify-self: center;
    width: min(100%, 560px);
    aspect-ratio: 1;
    border-radius: 50%;
    padding: clamp(8px, 1.1vw, 14px);
    background: conic-gradient(from 210deg, #f2f2f2, #6d6d6d, #d9d9d9, #4a4a4a, #bdbdbd, #f2f2f2);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6), 0 0 80px rgba(255, 166, 0, 0.12);
  }
  .portrait :global(img) {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .about-grid { grid-template-columns: 1fr; }
    .portrait { order: -1; width: min(70vw, 360px); }
  }
</style>
